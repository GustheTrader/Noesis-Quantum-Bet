# Copy to .env.local (gitignored via *.local) and fill in. Never commit real keys.
GEMINI_API_KEY=

# ESPN odds data store (self-hosted Supabase). Anon/publishable key only; RLS makes the espn schema read-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only: show synthetic matchups/lines on the OddsBoard instead of reading Supabase.
VITE_USE_MOCKS=false
