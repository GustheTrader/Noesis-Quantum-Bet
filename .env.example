# Copy to .env.local (gitignored via *.local) and fill in. Never commit real keys.
GEMINI_API_KEY=

# Supabase project used by lib/supabase.ts (app tables) and the espn odds reader. Anon/publishable key only.
# Required unless VITE_USE_MOCKS=true; the app throws at startup if missing. RLS makes the espn schema read-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only: show synthetic matchups/lines (OddsBoard, LiveOdds, TeamTicker) instead of reading Supabase.
VITE_USE_MOCKS=false
